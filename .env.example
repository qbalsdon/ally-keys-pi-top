# Upstash Redis credentials — used by:
#   • get-pi-ip.js         (on Mac, reads Pi's current LAN IP)
#   • services/ip-monitor.js (on Pi, writes IP on change)
#
# ⚠️  DO NOT commit .env to git — it is in .gitignore.
#     Set these in your shell rc (e.g. ~/.zshenv) or create .env from this template.
#
# Get your credentials at: https://console.upstash.com/redis

upstash_url=https://your-db.upstash.io
upstash_token=your_token_here
