# ally-keys-pi-top environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is in .gitignore — never commit it.

# ── Puter.js ──────────────────────────────────────────────────────────────────
# Used by ip-monitor.js (Pi) to store the Pi's IP, and by get-pi-ip.js (Mac)
# to read it back in deploy.sh.
#
# Get your token at: https://puter.com/dashboard#account
# → Account → API Tokens → Create token
PUTER_AUTH_TOKEN=your_puter_api_token_here
